generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────
// User
// ────────────────────────────────────────────────────────
model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  // Encrypted Anthropic API key (AES-256-GCM) — null once the user removes it
  apiKeyCipher    String?    // base64
  apiKeyNonce     String?    // base64
  apiKeyAuthTag   String?    // base64
  // Freshest folio insight, regenerated (best-effort) after each compose —
  // see agent/loop.js generateFolioInsight. Null falls back to the
  // template-built insight in routes/folio.js.
  insightText         String?   @db.Text
  insightGeneratedAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  walks           Walk[]
  agentRuns       AgentRun[]
}

// ────────────────────────────────────────────────────────
// Walk — a composed photography walking route
// ────────────────────────────────────────────────────────
model Walk {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  title           String     // e.g., "Edge Conditions"
  subtitle        String     // e.g., "A study of seams · 6 frames · B&W"
  brief           String     @db.Text

  // Where + when
  locationName    String     // e.g., "Mission District, San Francisco"
  centerLat       Float
  centerLng       Float
  date            DateTime
  timeOfDay       String     // 'dawn'|'morning'|'midday'|'golden'|'blue'|'night'

  // Logistics
  durationMin     Int
  distanceM       Int        // walking distance in meters
  cameraBody      String
  lensSpec        String
  mobility        String[]   // always ['foot'] — Latitude only routes walking
  styles          String[]   // ['street','architecture',...]
  intent          String?    @db.Text

  // Routing
  walkingPolyline String?    @db.Text // encoded polyline from Mapbox

  // Composed narrative
  conditions      Json       // { light, weather, camera_notes, afterward }

  status          String     @default("composed") // 'draft'|'composed'|'completed'
  createdAt       DateTime   @default(now())
  composedAt      DateTime?

  stops           Stop[]
  agentRun        AgentRun?

  // Every hot query (folio list, get_user_history, insight) orders by
  // `date` desc, not `createdAt` — index the column that's actually sorted on.
  @@index([userId, date(sort: Desc)])
}

// ────────────────────────────────────────────────────────
// Stop — a single photo stop on a walk
// ────────────────────────────────────────────────────────
model Stop {
  id              String     @id @default(cuid())
  walkId          String
  walk            Walk       @relation(fields: [walkId], references: [id], onDelete: Cascade)

  ordinal         Int        // 1-indexed
  name            String     // e.g., "Balmy Alley"
  lat             Float
  lng             Float
  arrivalTime     String     // "10:25" — display string
  durationMin     Int
  brief           String     @db.Text

  // No separate index on walkId alone — the unique constraint below already
  // leads with walkId, so Postgres can use it for walkId-only lookups too.
  @@unique([walkId, ordinal])
}

// ────────────────────────────────────────────────────────
// AgentRun — one dialogue session with the agent
// ────────────────────────────────────────────────────────
model AgentRun {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  walkId          String?    @unique
  walk            Walk?      @relation(fields: [walkId], references: [id], onDelete: SetNull)

  briefSnapshot   Json
  messages        Json       @default("[]")

  status          String     @default("active") // 'active'|'awaiting_user'|'composed'|'error'|'abandoned'
  errorMessage    String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}
